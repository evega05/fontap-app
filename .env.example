# Copiar a .env (nunca se commitea) y completar antes de compilar un
# release local con `cd android && ./gradlew bundleRelease`.
#
# Cómo conseguir estos 4 valores si la app ya se publicó antes y la
# keystore la generó EAS:
#   npx eas-cli credentials
#   -> Android -> production -> "Download existing keystore"
# Esto descarga un .jks/.keystore + un archivo con el alias y las dos
# contraseñas (store password y key password). NUNCA la generes de nuevo:
# Play Console rechaza un .aab firmado con una clave distinta a la
# original.
#
# Ruta absoluta o relativa a android/app/ del archivo de keystore
# descargado (movelo a algún lugar FUERA del repo, ej. ~/.android-keys/):
ANDROID_RELEASE_STORE_FILE=/ruta/absoluta/a/tu-keystore.jks

# Contraseña de la keystore (store password)
ANDROID_RELEASE_STORE_PASSWORD=

# Alias de la clave dentro de la keystore (key alias)
ANDROID_RELEASE_KEY_ALIAS=

# Contraseña de la clave (key password, puede ser igual a la de arriba)
ANDROID_RELEASE_KEY_PASSWORD=
