{
  "expo": {
    "name": "Multiservicios Provenza",
    "slug": "fontap",
    "scheme": "fontap",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080812"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fontap.app",
      "config": {
        "googleMapsApiKey": "AIzaSyA7ySPuuzWVj_rMIQU35VJk_XiVM-FSgAA"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.fontap.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA7ySPuuzWVj_rMIQU35VJk_XiVM-FSgAA"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.fontap.app",
          "enableGooglePay": true
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FonTap usa tu ubicación para mostrarte los fontaneros más cercanos y para que los clientes puedan encontrarte a ti."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Multiservicios Provenza necesita acceso a tus fotos para que puedas subir imágenes del trabajo, tu foto de perfil o adjuntar fotos en el chat."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0057D8"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "68eb608b-5bbc-457d-8146-6cd021aa6a58"
      }
    },
    "owner": "mathiasvegas-organization"
  }
}
